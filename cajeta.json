{
    // cajeta-graph — network analysis for the cajeta ecosystem: graph
    // construction (directed/undirected, weights, attributes, TYPED edges),
    // traversal and shortest paths, the centrality family (degree,
    // eigenvector, PageRank, betweenness, closeness), and Louvain community
    // detection with modularity.
    //
    // Graph analytics is NOT machine learning — the estimator protocol is
    // used nowhere — so this library depends on the stdlib alone
    // (ml-graph-analytics-spec §8.2, roadmap §4).
    //
    // Parity oracles (never ports): NetworkX 3.6.1 for construction,
    // traversal, and centrality; python-louvain 0.16 for community
    // detection. Fixture generators live in tools/fixtures/ and record the
    // pins; the oracle venv is code/ml/venv-graph-ref.
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable
    // `.cja` rather than an executable.
    //
    // VERSIONING — `details.version` is the SINGLE source of truth. It names
    // the built archive (`dev.cajeta.graph-<version>.cja`), it is what CI
    // publishes to Olla, and CI asserts a `v*` tag agrees with it.

    "details": {
        "name":               "dev.cajeta.graph",
        "version":            "0.1.2",
        "description":        "cajeta-graph — network analysis: graphs with typed edges, traversal and shortest paths, centrality incl. PageRank, and Louvain community detection",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // Compiler build this library is developed against (distinct from
        // cajeta-lang-version, which pins the language/stdlib API surface).
        // Keep it in step with `CAJETA_VERSION` in
        // .github/workflows/ci.yml — that one is what CI installs, this one
        // documents what the tree was gated on.
        "toolchain": {
            // The first pin this tree has ever carried, set at the
            // ecosystem's current release.
            //
            // It buys alignment rather than a capability. Measured on both
            // released binaries with dev.cajeta.unit 0.3.0 on the
            // classpath: the library builds, the suite reports 49 passed,
            // 0 failed, 1 skipped, and the tour's 14 sections all hold on
            // v0.28.0 and on v0.29.0 alike. Nothing in these sources needs
            // the newer build.
            //
            // There IS a floor, and it is far below both. The sources take
            // their traversal engine from cajeta.collection.graph.IndexGraph,
            // which the v0.17.0 stdlib does not have: that compiler fails
            // the build outright with CAJETA_ERROR_UNRESOLVED_TYPE at eight
            // sites in Core, Traversal and Components. v0.17.0 is what CI
            // installed until this commit, so the workflow's pin was a
            // false claim about what builds.
            //
            // Raised to 0.35.0 for the field-store rule, which GraphException now follows.
            "version": "0.35.0"
        },

        // Pure in-memory graph algorithms — no filesystem or network use.
        "capabilities": [],

        // The core stdlib (cajeta.lang, cajeta.collection, cajeta.math,
        // cajeta.nucleo, …) is built into the toolchain — not declared.
        "dependencies": {},

        // The suite is driven by cajeta-unit's reflective @Test discovery;
        // run-tests.sh resolves the archive (sibling checkout, then store,
        // then a sha256-verified Olla fetch at this pin).
        //
        // Raised from 0.2.1, which no current compiler will put on a
        // classpath. A consumer re-checks a dependency archive's OWN
        // sources, and 0.2.1's embedded ArgMatchers keeps a plain `pred`
        // parameter in a field: both v0.28.0 and v0.29.0 stop the build
        // with CAJETA_ERROR_CAPTURED_BORROW_PARAM. 0.3.0 carries the fix,
        // so this raise is forced by the dependency rather than by the
        // toolchain pin above. 0.3.3 is the unit release built for v0.35.0.
        "dev-dependencies": {
            "dev.cajeta.unit": "0.3.3"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` — this is a library; the build emits a .cja.
        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "tour": {
            "description": "Build + run the self-checking tour",
            "actions": [
                { "action": "exec", "command": "./run-tour.sh" }
            ]
        },

        "release": {
            "description": "Release build of the .cja",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Remove build outputs",
            "actions": [
                { "action": "exec", "command": "rm", "args": ["-rf", "build"] }
            ]
        }
    }
}
