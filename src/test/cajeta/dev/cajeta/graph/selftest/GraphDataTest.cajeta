package dev.cajeta.graph.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.graph.Graph;
import dev.cajeta.graph.GraphData;
import cajeta.collection.ArrayList;

/**
 * ml-graph-analytics plan 5.1.3 — the drawing boundary (spec §8.1).
 * Graph structure crosses to `dev.cajeta.chart` as plain DATA: identity
 * list + endpoint index arrays + optional weights/types. Node POSITIONS
 * are not computed here — there is deliberately no layout API on this
 * surface — and nothing in this library draws (verified at review,
 * plan 5.3.1).
 */
public class GraphDataTest {

    public GraphDataTest() { return; }

    @Test
    public void graphEmitsAsPlainData() {
        Graph g = Graph.directed();
        g.addTypedEdge("a", "b", "imports");
        g.addEdge("b", "c");
        g.setEdgeAttr("a", "b", "weight", 2.0);
        g.setEdgeAttr("b", "c", "weight", 0.5);

        ArrayList<String> ids = GraphData.nodeIds(g);
        Assert.equals((int64) 3, (int64) ids.count());
        Assert.equals("a", ids.get(0));
        Assert.equals("b", ids.get(1));
        Assert.equals("c", ids.get(2));

        int64[] src = GraphData.edgeSources(g);
        int64[] dst = GraphData.edgeTargets(g);
        Assert.equals((int64) 2, (int64) src.count());
        Assert.equals(g.indexOf("a"), src[0]);
        Assert.equals(g.indexOf("b"), dst[0]);
        Assert.equals(g.indexOf("b"), src[1]);
        Assert.equals(g.indexOf("c"), dst[1]);

        float64[] w = GraphData.edgeWeights(g, "weight");
        Assert.isTrue(w[0] == 2.0);
        Assert.isTrue(w[1] == 0.5);

        ArrayList<String> types = GraphData.edgeTypes(g);
        Assert.equals("imports", types.get(0));
        Assert.equals("", types.get(1));

        // Index-shaped results join by position: identity i <-> nodeAt(i).
        Assert.equals(ids.get((int32) g.indexOf("b")), "b");
    }
}
