package dev.cajeta.graph;

import cajeta.collection.ArrayList;
import cajeta.collection.HashMap;
import cajeta.nucleo.frame.Table;
import cajeta.nucleo.sparse.CsrMatrix;

/**
 * A directed or undirected graph with weights, named edge attributes, and
 * TYPED edges (ml-graph-analytics spec §2, §8.4, §8.5).
 *
 * **Identity.** Node identity is `String` at the boundary; internally every
 * node is a contiguous index `0..nodeCount()-1` in insertion order, with a
 * bidirectional identity map (§8.4) — arbitrary identity in, the same
 * identity out, and every algorithm stays array-shaped. Integer identifiers
 * enter as their string form (the `Table` path stringifies nothing — use
 * string columns).
 *
 * **Simple graph.** A duplicate `addEdge` UPDATES the existing edge rather
 * than duplicating it, NetworkX's `Graph`/`DiGraph` rule; parallel edges
 * therefore never exist (multigraphs are out of scope, spec §1.4). Self-loops
 * are allowed; a self-loop contributes 2 to degree (NetworkX's convention).
 *
 * **Weights.** There is no implicit weight. Edges carry named `float64`
 * attributes; every weighted algorithm names WHICH attribute it reads (§2.4),
 * and a missing attribute is loud (`GraphException`), never silently 1.
 *
 * **Typed edges (§8.5).** An edge optionally carries one type (`"imports"`,
 * `"calls"`, `"links-to"`, `"cites"`, …) beside its attributes; traversal can
 * select by type (`neighborsByType`). The untyped type is `""`.
 *
 * **Adjacency (plan 1.2.4, decided).** `CsrMatrix` is construction-immutable
 * (`fromCoo`/`fromDense` only), so it does NOT fit as the primary store for a
 * mutable graph. Adjacency is purpose-built — per-node insertion-ordered
 * incident-edge lists over a flat edge table — which keeps memory
 * proportional to edges (§2.8) and neighbour order deterministic (§3.1).
 * `CsrMatrix` remains the EXPORT (`toCsr`, §2.9/§7.3): node ordering is the
 * stable insertion order, documented here.
 */
public final class Graph {

    private boolean dir;
    /** index -> identity, insertion-ordered (the documented ordering). */
    private ArrayList<String> ids;
    /** identity -> index. */
    private HashMap<String, int64> idx;

    /** Flat edge table; edge id = insertion index. */
    private ArrayList<int64> esrc;
    private ArrayList<int64> edst;
    /** Interned edge type per edge; -1 = untyped. */
    private ArrayList<int64> etype;
    private ArrayList<String> typeNames;
    private HashMap<String, int64> typeIds;
    /** Named attribute columns, dense per edge; NaN = unset. */
    private HashMap<String, ArrayList<float64>> eattrs;
    private ArrayList<String> attrNames;

    /** Per-node incident edge ids: out-edges when directed, both endpoints
     *  when undirected (a self-loop appears once). Insertion-ordered. */
    private ArrayList<ArrayList<int64>> adj;
    /** Directed only: per-node in-edges. */
    private ArrayList<ArrayList<int64>> radj;

    private Graph(boolean directed) {
        this.dir = directed;
        this.ids #= heap ArrayList<String>();
        this.idx #= heap HashMap<String, int64>(64);
        this.esrc #= heap ArrayList<int64>();
        this.edst #= heap ArrayList<int64>();
        this.etype #= heap ArrayList<int64>();
        this.typeNames #= heap ArrayList<String>();
        this.typeIds #= heap HashMap<String, int64>(16);
        this.eattrs #= heap HashMap<String, ArrayList<float64>>(16);
        this.attrNames #= heap ArrayList<String>();
        this.adj #= heap ArrayList<ArrayList<int64>>();
        this.radj #= heap ArrayList<ArrayList<int64>>();
    }

    /** A new undirected graph: `(u,v)` and `(v,u)` are the same edge. */
    public static #Graph undirected() {
        return #heap Graph(false);
    }

    /** A new directed graph: `(u,v)` and `(v,u)` are distinct edges. */
    public static #Graph directed() {
        return #heap Graph(true);
    }

    public boolean isDirected() {
        return this.dir;
    }

    // ------------------------------------------------------------------
    // Nodes
    // ------------------------------------------------------------------

    private static #String own(String s) {
        return s.substring(0, (int32) s.count());
    }

    /**
     * Add a node; idempotent. Returns the node's contiguous internal index
     * (existing index when the identity is already present).
     */
    public int64 addNode(String id) {
        if (this.idx.containsKey(id)) {
            return this.idx.get(id);
        }
        int64 i = (int64) this.ids.count();
        String k1 = Graph.own(id);
        String k2 = Graph.own(id);
        this.ids.add(#k1);
        this.idx.put(#k2, i);
        ArrayList<int64> a = heap ArrayList<int64>();
        this.adj.add(#a);
        ArrayList<int64> r = heap ArrayList<int64>();
        this.radj.add(#r);
        return i;
    }

    public boolean hasNode(String id) {
        return this.idx.containsKey(id);
    }

    /** Internal index of `id`, or -1 when absent — an explicit answer. */
    public int64 indexOf(String id) {
        if (!this.idx.containsKey(id)) {
            return (int64) -1;
        }
        return this.idx.get(id);
    }

    /** The identity at internal index `i` (borrow; throws out of range). */
    public String nodeAt(int64 i) {
        return this.ids.get((int32) i);
    }

    public int64 nodeCount() {
        return (int64) this.ids.count();
    }

    public int64 edgeCount() {
        return (int64) this.esrc.count();
    }

    // ------------------------------------------------------------------
    // Edges
    // ------------------------------------------------------------------

    /** Edge id of (u,v) by INDEX, honouring direction; -1 when absent. */
    private int64 findEdge(int64 ui, int64 vi) {
        ArrayList<int64> a = this.adj.get((int32) ui);
        int32 k = 0;
        while (k < a.count()) {
            int64 e = a.get(k);
            int64 s = this.esrc.get((int32) e);
            int64 d = this.edst.get((int32) e);
            if (this.dir) {
                if (s == ui && d == vi) {
                    return e;
                }
            } else {
                int64 other = d;
                if (d == ui && s != ui) {
                    other = s;
                }
                if (s == ui && d == ui) {
                    other = ui;
                }
                if (other == vi) {
                    return e;
                }
            }
            k = k + 1;
        }
        return (int64) -1;
    }

    /** Edge id of (u,v) by identity; -1 when either node or the edge is absent. */
    public int64 edgeIdOf(String u, String v) {
        int64 ui = this.indexOf(u);
        int64 vi = this.indexOf(v);
        if (ui < 0 || vi < 0) {
            return (int64) -1;
        }
        return this.findEdge(ui, vi);
    }

    /**
     * Add an edge, creating unknown nodes (§2.1). A duplicate add UPDATES —
     * the existing edge id is returned and nothing is silently altered
     * (§2.6). Returns the edge id.
     */
    public int64 addEdge(String u, String v) {
        int64 ui = this.addNode(u);
        int64 vi = this.addNode(v);
        int64 existing = this.findEdge(ui, vi);
        if (existing >= 0) {
            return existing;
        }
        int64 e = (int64) this.esrc.count();
        this.esrc.add(ui);
        this.edst.add(vi);
        this.etype.add((int64) -1);
        // Every attribute column stays dense: extend with NaN (= unset).
        int32 c = 0;
        while (c < this.attrNames.count()) {
            ArrayList<float64> col = this.eattrs.get(this.attrNames.get(c));
            col.add(Graph.nan());
            c = c + 1;
        }
        this.adj.get((int32) ui).add(e);
        if (this.dir) {
            this.radj.get((int32) vi).add(e);
        } else {
            if (vi != ui) {
                this.adj.get((int32) vi).add(e);
            }
        }
        return e;
    }

    /**
     * Add an edge carrying a type (§8.5). On an existing (u,v) edge the
     * type is UPDATED (the §2.6 rule: update, never duplicate).
     */
    public int64 addTypedEdge(String u, String v, String type) {
        int64 e = this.addEdge(u, v);
        this.etype.set((int32) e, this.internType(type));
        return e;
    }

    private int64 internType(String type) {
        if (this.typeIds.containsKey(type)) {
            return this.typeIds.get(type);
        }
        int64 t = (int64) this.typeNames.count();
        String n1 = Graph.own(type);
        String n2 = Graph.own(type);
        this.typeNames.add(#n1);
        this.typeIds.put(#n2, t);
        return t;
    }

    public boolean hasEdge(String u, String v) {
        return this.edgeIdOf(u, v) >= 0;
    }

    /**
     * The type of edge (u,v); `""` for an untyped edge. Throws when the
     * edge does not exist.
     */
    public #String edgeType(String u, String v) {
        int64 e = this.requireEdge(u, v);
        int64 t = this.etype.get((int32) e);
        if (t < 0) {
            return "";
        }
        return Graph.own(this.typeNames.get((int32) t));
    }

    private int64 requireEdge(String u, String v) {
        int64 e = this.edgeIdOf(u, v);
        if (e < 0) {
            throw heap GraphException("no such edge");
        }
        return e;
    }

    // ------------------------------------------------------------------
    // Edge attributes (named; no implicit weight — §2.4)
    // ------------------------------------------------------------------

    private static float64 nan() {
        float64 z = 0.0;
        return z / z;
    }

    /** Set attribute `name` on edge (u,v). Throws when the edge is absent. */
    public void setEdgeAttr(String u, String v, String name, float64 value) {
        int64 e = this.requireEdge(u, v);
        this.setEdgeAttrByEid(e, name, value);
    }

    /** Set attribute `name` on edge id `e` (the `fromTable` fast path). */
    public void setEdgeAttrByEid(int64 e, String name, float64 value) {
        if (!this.eattrs.containsKey(name)) {
            ArrayList<float64> col = heap ArrayList<float64>();
            int32 i = 0;
            while (i < this.esrc.count()) {
                col.add(Graph.nan());
                i = i + 1;
            }
            String n1 = Graph.own(name);
            String n2 = Graph.own(name);
            this.attrNames.add(#n1);
            this.eattrs.put(#n2, #col);
        }
        this.eattrs.get(name).set((int32) e, value);
    }

    /** Whether edge (u,v) carries attribute `name`. */
    public boolean hasEdgeAttr(String u, String v, String name) {
        int64 e = this.edgeIdOf(u, v);
        if (e < 0) {
            return false;
        }
        if (!this.eattrs.containsKey(name)) {
            return false;
        }
        float64 x = this.eattrs.get(name).get((int32) e);
        return x == x;
    }

    /**
     * Attribute `name` of edge (u,v). Missing attribute (or missing edge)
     * throws — a weight is never silently 1 (§2.4).
     */
    public float64 edgeAttr(String u, String v, String name) {
        int64 e = this.requireEdge(u, v);
        return this.edgeAttrByEid(e, name);
    }

    /** Attribute `name` of edge id `e`; throws when unset. */
    public float64 edgeAttrByEid(int64 e, String name) {
        if (!this.eattrs.containsKey(name)) {
            throw heap GraphException("no such edge attribute");
        }
        float64 x = this.eattrs.get(name).get((int32) e);
        if (x != x) {
            throw heap GraphException("edge attribute unset on this edge");
        }
        return x;
    }

    // ------------------------------------------------------------------
    // Degrees, density, neighbours (§2.7)
    // ------------------------------------------------------------------

    private int64 requireNode(String id) {
        int64 i = this.indexOf(id);
        if (i < 0) {
            throw heap GraphException("no such node");
        }
        return i;
    }

    /** Out-degree when directed; plain degree when undirected. */
    public int64 outDegree(String id) {
        int64 i = this.requireNode(id);
        if (!this.dir) {
            return this.degreeAt(i);
        }
        return (int64) this.adj.get((int32) i).count();
    }

    /** In-degree when directed; plain degree when undirected. */
    public int64 inDegree(String id) {
        int64 i = this.requireNode(id);
        if (!this.dir) {
            return this.degreeAt(i);
        }
        return (int64) this.radj.get((int32) i).count();
    }

    /**
     * Degree. Directed: in + out. Undirected: incident edges with a
     * self-loop contributing 2 (NetworkX's convention).
     */
    public int64 degree(String id) {
        int64 i = this.requireNode(id);
        return this.degreeAt(i);
    }

    /** Degree by internal index (the array-shaped surface for algorithms). */
    public int64 degreeAt(int64 i) {
        if (this.dir) {
            return (int64) this.adj.get((int32) i).count()
                 + (int64) this.radj.get((int32) i).count();
        }
        ArrayList<int64> a = this.adj.get((int32) i);
        int64 deg = (int64) a.count();
        int32 k = 0;
        while (k < a.count()) {
            int64 e = a.get(k);
            if (this.esrc.get((int32) e) == this.edst.get((int32) e)) {
                deg = deg + 1;
            }
            k = k + 1;
        }
        return deg;
    }

    /**
     * Density: `m / (n(n-1))` directed, `2m / (n(n-1))` undirected
     * (NetworkX). 0 for graphs with fewer than 2 nodes.
     */
    public float64 density() {
        float64 n = (float64) this.nodeCount();
        float64 m = (float64) this.edgeCount();
        if (n < 2.0) {
            return 0.0;
        }
        if (this.dir) {
            return m / (n * (n - 1.0));
        }
        return 2.0 * m / (n * (n - 1.0));
    }

    /**
     * Neighbour identities of `id`, in deterministic edge-insertion order
     * (§3.1): successors when directed, all adjacent when undirected.
     */
    public #ArrayList<String> neighborsOf(String id) {
        return this.neighborsSelect(id, (int64) -2);
    }

    /**
     * Neighbours of `id` reachable over edges of `type` (§8.5), in
     * deterministic edge-insertion order. An unknown type selects nothing.
     */
    public #ArrayList<String> neighborsByType(String id, String type) {
        int64 want = (int64) -1;
        if (this.typeIds.containsKey(type)) {
            want = this.typeIds.get(type);
        } else {
            ArrayList<String> empty = heap ArrayList<String>();
            return #empty;
        }
        return this.neighborsSelect(id, want);
    }

    /** typeFilter -2 = all edges; otherwise only edges of that type id. */
    private #ArrayList<String> neighborsSelect(String id, int64 typeFilter) {
        int64 i = this.requireNode(id);
        ArrayList<String> out = heap ArrayList<String>();
        ArrayList<int64> a = this.adj.get((int32) i);
        int32 k = 0;
        while (k < a.count()) {
            int64 e = a.get(k);
            if (typeFilter != (int64) -2
                    && this.etype.get((int32) e) != typeFilter) {
                k = k + 1;
                continue;
            }
            int64 s = this.esrc.get((int32) e);
            int64 d = this.edst.get((int32) e);
            int64 other = d;
            if (!this.dir && d == i && s != i) {
                other = s;
            }
            String nb = Graph.own(this.ids.get((int32) other));
            out.add(#nb);
            k = k + 1;
        }
        return #out;
    }

    // ------------------------------------------------------------------
    // Array-shaped surface for algorithms (U2+): everything by index.
    // ------------------------------------------------------------------

    /** Incident (out-)edge count at node index `i`. */
    public int64 edgeCountAt(int64 i) {
        return (int64) this.adj.get((int32) i).count();
    }

    /** k-th incident (out-)edge id at node index `i`, insertion-ordered. */
    public int64 edgeAt(int64 i, int64 k) {
        return this.adj.get((int32) i).get((int32) k);
    }

    /** In-edge count at node index `i` (directed graphs). */
    public int64 inEdgeCountAt(int64 i) {
        return (int64) this.radj.get((int32) i).count();
    }

    /** k-th in-edge id at node index `i` (directed graphs). */
    public int64 inEdgeAt(int64 i, int64 k) {
        return this.radj.get((int32) i).get((int32) k);
    }

    public int64 edgeSrc(int64 e) {
        return this.esrc.get((int32) e);
    }

    public int64 edgeDst(int64 e) {
        return this.edst.get((int32) e);
    }

    /** The endpoint of edge `e` that is not node index `i` (self-loop: `i`). */
    public int64 edgeOther(int64 e, int64 i) {
        int64 s = this.esrc.get((int32) e);
        int64 d = this.edst.get((int32) e);
        if (s == i) {
            return d;
        }
        return s;
    }

    /** Interned type id of edge `e`; -1 = untyped. */
    public int64 edgeTypeIdOf(int64 e) {
        return this.etype.get((int32) e);
    }

    /** Interned id of `type`; -1 when no edge ever carried it. */
    public int64 typeIdOf(String type) {
        if (!this.typeIds.containsKey(type)) {
            return (int64) -1;
        }
        return this.typeIds.get(type);
    }

    // ------------------------------------------------------------------
    // Table construction (§2.3) and CSR export (§2.9, §7.3)
    // ------------------------------------------------------------------

    /**
     * Build a graph from an edge-list `Table` naming the source and target
     * string columns — NetworkX's `from_pandas_edgelist` (§2.3). No
     * attribute columns are attached.
     */
    public static #Graph fromTable(Table<?> t, String srcCol, String dstCol,
                                   boolean directed) {
        String[] none = heap String[0];
        return Graph.fromTableAttrs(t, srcCol, dstCol, directed, none);
    }

    /**
     * `fromTable` with the named `float64` columns attached as edge
     * attributes under their column names (§2.3's optional half).
     */
    public static #Graph fromTableAttrs(Table<?> t, String srcCol,
                                        String dstCol, boolean directed,
                                        String[] attrCols) {
        Graph g = heap Graph(directed);
        int64 n = t.rowCount();
        int64 r = 0;
        while (r < n) {
            String s = t.strAt(srcCol, r);
            String d = t.strAt(dstCol, r);
            int64 e = g.addEdge(s, d);
            int64 c = 0;
            while (c < attrCols.count()) {
                g.setEdgeAttrByEid(e, attrCols[c], t.f64At(attrCols[c], r));
                c = c + 1;
            }
            r = r + 1;
        }
        return #g;
    }

    /**
     * Sparse adjacency as a `CsrMatrix` (§2.9, §7.3): entry `(i,j)` is 1.0
     * per edge; an undirected edge contributes both orientations. Node
     * ordering is the stable insertion order (`nodeAt`).
     */
    public #CsrMatrix toCsr() {
        return this.toCsrInternal("", false);
    }

    /**
     * Weighted sparse adjacency: entry `(i,j)` is edge attribute `attr`.
     * An edge with the attribute unset throws (§2.4 — never silently 1).
     */
    public #CsrMatrix toCsrWeighted(String attr) {
        return this.toCsrInternal(attr, true);
    }

    private #CsrMatrix toCsrInternal(String attr, boolean weighted) {
        int64 m = this.edgeCount();
        int64 selfLoops = 0;
        int64 e = 0;
        while (e < m) {
            if (this.esrc.get((int32) e) == this.edst.get((int32) e)) {
                selfLoops = selfLoops + 1;
            }
            e = e + 1;
        }
        int64 nnz = m;
        if (!this.dir) {
            nnz = m * (int64) 2 - selfLoops;
        }
        int64[] rows = heap int64[nnz];
        int64[] cols = heap int64[nnz];
        float64[] vals = heap float64[nnz];
        int64 w = 0;
        e = 0;
        while (e < m) {
            int64 s = this.esrc.get((int32) e);
            int64 d = this.edst.get((int32) e);
            float64 x = 1.0;
            if (weighted) {
                x = this.edgeAttrByEid(e, attr);
            }
            rows[w] = s;
            cols[w] = d;
            vals[w] = x;
            w = w + 1;
            if (!this.dir && s != d) {
                rows[w] = d;
                cols[w] = s;
                vals[w] = x;
                w = w + 1;
            }
            e = e + 1;
        }
        int64 n = this.nodeCount();
        return CsrMatrix.fromCoo(rows, cols, vals, nnz, n, n);
    }
}
