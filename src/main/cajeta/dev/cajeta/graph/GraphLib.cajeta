package dev.cajeta.graph;

/**
 * cajeta-graph — network analysis for the cajeta ecosystem: graph
 * construction (directed/undirected, weights, attributes, typed edges),
 * traversal and shortest paths, the centrality family (degree, eigenvector,
 * PageRank, betweenness, closeness), and Louvain community detection with
 * modularity.
 *
 * Graph analytics is not machine learning — nothing here uses the estimator
 * protocol — so this library depends on the stdlib alone. It also draws
 * nothing: graph data is emitted for `dev.cajeta.chart` to render.
 *
 * This is the library entry class (the `--emit=cja` root). The surface lands
 * unit by unit per the ml-graph-analytics plan.
 */
public final class GraphLib {
    /** The library version. */
    public static #String version() { return "0.1.0"; }

    /** `--emit=cja` entry. */
    public static int32 run() { return 0; }
}
