package dev.cajeta.graph;

import cajeta.collection.ArrayList;
import cajeta.collection.graph.IndexGraph;

/**
 * Traversal (spec §3.1). Visit orders are DETERMINISTIC and documented:
 * neighbours are taken in edge-insertion order (the graph's adjacency
 * order), BFS is FIFO over that order, DFS is preorder over it. Repeated
 * runs on the same graph produce identical sequences — nothing downstream
 * is reproducible without this.
 */
public final class Traversal {

    /** Breadth-first visit order from `source` (identities). */
    public static #ArrayList<String> bfs(Graph g, String source) {
        int64 s = g.indexOf(source);
        if (s < 0) {
            throw heap GraphException("bfs: no such node");
        }
        // Index-level order from the stdlib engine over the direction-aware
        // mirror; this method's own work is identity mapping at the edges.
        IndexGraph ig #= Core.mirror(g);
        int32[] order #= ig.bfsOrder((int32) s);
        return Traversal.identities(g, order);
    }

    /** Depth-first PREORDER from `source` (identities). */
    public static #ArrayList<String> dfs(Graph g, String source) {
        int64 s = g.indexOf(source);
        if (s < 0) {
            throw heap GraphException("dfs: no such node");
        }
        IndexGraph ig #= Core.mirror(g);
        int32[] order #= ig.dfsOrder((int32) s);
        return Traversal.identities(g, order);
    }

    /** Map an index order back to owned identity strings. */
    static #ArrayList<String> identities(Graph g, int32[] order) {
        ArrayList<String> out = heap ArrayList<String>();
        int32 n = (int32) order.count();
        int32 i = 0;
        while (i < n) {
            String id = g.nodeAt((int64) order[i]);
            String own = id.substring(0, (int32) id.count());
            out.add(#own);
            i = i + 1;
        }
        return #out;
    }
}
